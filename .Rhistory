library(dplyr)
library(tidyr)
library(glmmTMB)
source("helper/setting.R")
source("Downloads/research/selfcontrol_ratings/helper/setting.R")
source("../research/selfcontrol_ratings/helper/setting.R")
source("../selfcontrol_ratings/helper/setting.R")
dataset = "food1"
config <- dataset_configs[[dataset]]
folder.data  <- file.path(pathToFolder, "data", dataset)
load(file.path(folder.data, config$data.file))
data_all <- Data[(Data$Challeng==1)&(Data$InitialFixation==1)&(Data$condition == 1),]
longData <- data_all %>%
# If you already have a trial identifier, remove the next line.
mutate(trial = row_number()) %>%
# Pivot taste & health proportions to long format
pivot_longer(
cols = c(percFixTasteRating, percFixHealthRating),
names_to = "ratingType",
values_to = "percFix",
names_pattern = "percFix(.*)Rating"
) %>%
# ratingType will be "Taste" or "Health" from the regex capture; normalize to lowercase
mutate(
ratingType = tolower(ratingType),
ratingType = factor(ratingType, levels = c("health", "taste")) # health as baseline
) %>%
glmm_model <- glmmTMB(
percFix ~ ratingType * (valueLR_taste_abs_true + valueLR_health_abs_true) +
(1 | subnum),
data = longData,
family = beta_family(link = "logit")
)
longData <- data_all %>%
# If you already have a trial identifier, remove the next line.
mutate(trial = row_number()) %>%
# Pivot taste & health proportions to long format
pivot_longer(
cols = c(percFixTasteRating, percFixHealthRating),
names_to = "ratingType",
values_to = "percFix",
names_pattern = "percFix(.*)Rating"
) %>%
# ratingType will be "Taste" or "Health" from the regex capture; normalize to lowercase
mutate(
ratingType = tolower(ratingType),
ratingType = factor(ratingType, levels = c("health", "taste")) # health as baseline
)
glmm_model <- glmmTMB(
percFix ~ ratingType * (valueLR_taste_abs_true + valueLR_health_abs_true) +
(1 | subnum),
data = longData,
family = beta_family(link = "logit")
)
View(longData)
library(lme4)
library(lme4)
data_all$Delta = data_all$percFixTasteRating - data_all$percFixHealthRating
lmer_model <- lmer(
Delta ~ valueLR_taste_abs_true + valueLR_health_abs_true + (1 | subnum),
data = data_all
)
summary(lmer_model)
lmer_model <- glmer(
Delta ~ valueLR_taste_abs_true + valueLR_health_abs_true + (1 | subnum),
data = data_all
)
library(lmerTest)
lmer_model <- lmerTest::lmer(
Delta ~ valueLR_taste_abs_true + valueLR_health_abs_true + (1 | subnum),
data = data_all
)
summary(lmer_model)
data_all$fixationTimeDiff = data_all$fixationTimeHealthRating - data_all$fixationTimeTasteRating
lmer_model <- lmerTest::lmer(
fixationTimeDiff ~ valueLR_taste_abs_true + valueLR_health_abs_true + (1 | subnum),
data = data_all
)
summary(lmer_model)
data_all$fixationTimeDiff = data_all$fixationTimeTasteRating - data_all$fixationTimeHealthRating
lmer_model <- lmerTest::lmer(
fixationTimeDiff ~ valueLR_taste_abs_true + valueLR_health_abs_true + (1 | subnum),
data = data_all
)
summary(lmer_model)
