#                                   data = undo_data, family = "binomial")
model_undo_full = lme4::glmer(firstUndo ~  1 + cumulative_error*checkEnd  + (1 + cumulative_error + checkEnd |subjects) + (1 + cumulative_error + checkEnd|puzzleID),
data = undo_data, family = "binomial",
control = lmerControl(optimizer = "bobyqa",
optCtrl = list(maxfun = 1e5)))
# model_undo = lme4::glmer(firstUndo ~  1 + cumulative_error*checkEnd  + (1 |subjects) + (1|puzzleID),
